{
  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp",
    "*.inl": "cpp",
    "*.cu": "cpp",
    "*.cuh": "cpp",
    "*.inc": "cpp"
  },

  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled",

  "search.exclude": {
    "**/VS/x64/**": true,
    "**/VS/Intermediate/**": true,
    "**/.vs/**": true,
    "**/bin/**": true
  },

  "files.exclude": {
    "**/.vs": true
  }
}