<?xml version="1.0" encoding="UTF-8" ?>
<case>
    <casedef>
        <constantsdef>
            <gravity x="0" y="0" z="-9.81" comment="Gravitational acceleration" units_comment="m/s^2" />
            <rhop0 value="2150" comment="Bui and Nguyen (2021) / Qiao et al. (2024): sensitive clay density" units_comment="kg/m^3" />
            <rhopgradient value="2" comment="Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height" />
            <hswl value="0" auto="true" comment="Maximum still water level to calculate speedofsound using coefsound" units_comment="metres (m)" />
            <gamma value="7" comment="Polytropic constant used in the state equation" />
            <speedsystem value="0" auto="true" comment="Maximum system speed" />
            <coefsound value="20" comment="Coefficient to multiply speedsystem when speedsound is automatic" />
            <speedsound value="446" auto="false" comment="Approximate elastic wave speed from E=25 MPa, nu=0.49 and rho=2150 kg/m^3" />
            <hdp value="1.44" comment="Medium-resolution h/dp used by Bui and Nguyen (2021)" />
            <cflnumber value="0.2" comment="Courant number" />
        </constantsdef>
        <mkconfig boundcount="240" fluidcount="9" />
        <geometry>
            <predefinition>
                <newvarcte Dp="0.10" _rem="Bui and Nguyen (2021): initial interparticle distance 0.1 m" />
                <newvarcte Height="5.0" />
                <newvarcte SoilTopLength="20.0" />
                <newvarcte SoilBaseLength="25.0" />
                <newvarcte DomainLength="50.0" />
                <newvar Hdp="Dp/2" />
            </predefinition>
            <definition dp="#Dp" units_comment="metres (m)">
                <pointmin x="#-Dp*10" y="0" z="#-Dp*10" />
                <pointmax x="#DomainLength+Dp*10" y="0" z="#Height+Dp*10" />
            </definition>
            <commands>
                <list name="GeometryForNormals">
                    <setactive drawpoints="0" drawshapes="1" />
                    <setshapemode>actual | bound</setshapemode>
                    <setmkbound mk="0" />
                    <drawextrude closed="false">
                        <point x="#Hdp" y="-0.1" z="#Height+Hdp" />
                        <point x="#Hdp" y="-0.1" z="#Hdp" />
                        <point x="#DomainLength-Hdp" y="-0.1" z="#Hdp" />
                        <extrude x="0" y="0.2" z="0" />
                    </drawextrude>
                    <shapeout file="hdp" />
                    <resetdraw />
                </list>
                <mainlist>
                    <runlist name="GeometryForNormals" />
                    <setdrawmode mode="full" />
                    <setmkbound mk="0" />
                    <drawextrude closed="false">
                        <point x="0" y="0" z="#Height" />
                        <point x="0" y="0" z="0" />
                        <point x="#DomainLength" y="0" z="0" />
                        <extrude x="0" y="0.1" z="0" />
                        <layers vdp="0,-0.5,-1,-1.5,-2,-2.5,-3" />
                    </drawextrude>
                    <setmkfluid mk="0" />
                    <drawprism>
                        <point x="#Hdp" y="0" z="#Hdp" />
                        <point x="#SoilBaseLength-Hdp" y="0" z="#Hdp" />
                        <point x="#SoilTopLength+Hdp" y="0" z="#Height-Hdp" />
                        <point x="#Hdp" y="0" z="#Height-Hdp" />
                        <point x="#Hdp" y="0.1" z="#Hdp" />
                        <point x="#SoilBaseLength-Hdp" y="0.1" z="#Hdp" />
                        <point x="#SoilTopLength+Hdp" y="0.1" z="#Height-Hdp" />
                        <point x="#Hdp" y="0.1" z="#Height-Hdp" />
                    </drawprism>
                    <shapeout file="" />
                </mainlist>
            </commands>
        </geometry>
        <normals>
            <distanceh value="3.0" comment="Normal search distance for mDBC boundary" />
            <geometryfile file="[CaseName]_hdp_Actual.vtk" comment="File with boundary geometry for mDBC normals" />
            <svshapes value="1" comment="Save normal-generation geometry for inspection" />
        </normals>
    </casedef>
    <execution>
        <special>
            <soils>
                <phi value="0" comment="Undrained sensitive clay: phi_u = 0" />
                <coh value="25000" comment="Peak undrained cohesion cp = 25 kPa; CPU restart trigger applies FOS=1.65 to this value" />
                <dlt value="0" comment="Undrained dilatancy angle" />
                <ModulusE value="25e6" comment="Young's modulus E = 25 MPa" />
                <PRvs value="0.49" comment="Undrained Poisson ratio" />
                <phi_r value="0" comment="Residual friction angle" />
                <n_phi value="0" comment="Friction softening disabled because phi=phi_r=0" />
                <coh_r value="1500" comment="Residual cohesion cr = 1.5 kPa" />
                <n_coh value="5" comment="Exponential cohesion softening coefficient eta = 5" />
                <SoilTriggerFos value="1.65" comment="Peak strength reduction factor applied to cohesion in CPU restart softening stage" />
            </soils>
        </special>
        <parameters>
            <parameter key="SavePosDouble" value="0" comment="Saves particle position using double precision" />
            <parameter key="DPCtes" value="3" comment="DP constants type 3: 2D plane strain" />
            <parameter key="Boundary" value="2" comment="Boundary method 1:DBC, 2:mDBC" />
            <parameter key="SlipMode" value="2" comment="No-slip mDBC for the bottom and left wall in this first reproducibility case" />
            <parameter key="StepAlgorithm" value="2" comment="Step Algorithm 1:Verlet, 2:Symplectic" />
            <parameter key="VerletSteps" value="40" comment="Verlet only: Number of steps to apply Euler timestepping" />
            <parameter key="Kernel" value="2" comment="Interaction Kernel 1:Cubic Spline, 2:Wendland" />
            <parameter key="ViscoTreatment" value="1" comment="Viscosity formulation 1:Artificial, 2:Laminar+SPS" />
            <parameter key="Visco" value="0.1" comment="Artificial viscosity coefficient" />
            <parameter key="ViscoBoundFactor" value="1" comment="Multiply viscosity value with boundary" />
            <parameter key="ArtificialStress" value="1" comment="Bui 2008 tensile instability treatment 0:None, 1:Enable" />
            <parameter key="SoilDamping" value="0" comment="Failure stage: no artificial damping after initial stress generation" />
            <parameter key="SoilDampingCoef" value="0.02" comment="Unused when SoilDamping=0" />
            <parameter key="DensityDT" value="3" comment="Stress diffusion 0:None, 1:Molteni, 2:Feng, 3:Feng(full)" />
            <parameter key="DensityDTvalue" value="0.1" comment="Stress diffusion coefficient" />
            <parameter key="Shifting" value="0" comment="Shifting mode 0:None, 1:Ignore bound, 2:Ignore fixed, 3:Full" />
            <parameter key="ShiftCoef" value="-2" comment="Coefficient for shifting computation" />
            <parameter key="ShiftTFS" value="1.5" comment="Threshold to detect free surface" />
            <parameter key="RigidAlgorithm" value="1" comment="Rigid Algorithm 1:SPH, 2:DEM, 3:Chrono" />
            <parameter key="FtPause" value="0.0" comment="Time to freeze floatings at simulation start" units_comment="seconds" />
            <parameter key="CoefDtMin" value="0.01" comment="Coefficient to calculate minimum time step" />
            <parameter key="DtIni" value="0" comment="Initial time step. Use 0 for default" units_comment="seconds" />
            <parameter key="DtMin" value="0" comment="Minimum time step. Use 0 for default" units_comment="seconds" />
            <parameter key="DtFixed" value="0" comment="Fixed Dt value. Use 0 to disable" units_comment="seconds" />
            <parameter key="DtFixedFile" value="NONE" comment="Dt values are loaded from file. Use NONE to disable" />
            <parameter key="DtAllParticles" value="0" comment="Velocity of particles used to calculate DT. 1:All, 0:Only fluid/floating" />
            <parameter key="TimeMax" value="15.0" comment="Retrogressive failure duration used in Bui and Nguyen (2021)" units_comment="seconds" />
            <parameter key="TimeOut" value="0.1" comment="Time between output files" units_comment="seconds" />
            <parameter key="PartsOutMax" value="1" comment="Allowed fraction of fluid particles out of domain" units_comment="decimal" />
            <parameter key="RhopOutMin" value="1000" comment="Minimum valid density" units_comment="kg/m^3" />
            <parameter key="RhopOutMax" value="3000" comment="Maximum valid density" units_comment="kg/m^3" />
            <simulationdomain comment="Defines domain of simulation">
                <posmin x="default - 1" y="default" z="default - 1" />
                <posmax x="default + 1" y="default" z="default + 5" />
            </simulationdomain>
        </parameters>
    </execution>
</case>
