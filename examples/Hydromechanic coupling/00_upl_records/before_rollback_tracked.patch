+  for(unsigned p=0;p<Np;p++)if(CODE_IsNormal(Codec[p])){
+    if(PeriActive){
+      if(Idpc[p]>=CaseNp || owner[Idpc[p]]!=UINT_MAX)
+        Run_Exceptioon("PoreDynamicDarcy: invalid or duplicate normal particle ID.");
+      owner[Idpc[p]]=p;
+    }
