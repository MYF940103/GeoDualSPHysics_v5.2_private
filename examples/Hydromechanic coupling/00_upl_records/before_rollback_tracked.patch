+//==============================================================================
+/// Adds +(Kw/n)*(k/gref)*div(a_s) [Pa/s], for constant n and conductivity k [m/s].
+/// The corrected difference gradient annihilates constant acceleration in the
+/// interior. Variable k requires div(k*a_s), and is deliberately not used here.
+//==============================================================================
+template<TpKernel tker,bool sim2d> void JSphCpu::AddPorePressureDynamicDarcyRateT(const tdouble3 *acceleration){
+  const double gnorm=sqrt(double(Gravity.x)*Gravity.x+double(Gravity.y)*Gravity.y+double(Gravity.z)*Gravity.z);
+  const double gref=(gnorm>0? gnorm: 9.80665); //-Same conductivity convention as PR diffusion.
+  const double coef=double(SoilCte.PoreWaterBulkModulus)/double(SoilCte.Porosity)
+    *double(SoilCte.HydraulicConductivity)/gref;
+  if(!std::isfinite(coef))Run_Exceptioon("PoreDynamicDarcy: non-finite dynamic Darcy coefficient.");
+  const bool drainfs=IsHydroMechDrainageActive();
+  unsigned invalid=0;
+  const int pfin=int(Np);
+  #ifdef OMP_USE
+    #pragma omp parallel for schedule(guided) reduction(+:invalid)
+  #endif
+  for(int p1=int(Npb);p1<pfin;p1++){
+    if(!CODE_IsNormal(Codec[p1]) || !CODE_IsFluid(Codec[p1]))continue;
+    if(drainfs && IsHydroMechDrainedParticle(unsigned(p1),Posc,Codec,FSTypec))continue;
+    const tdouble3 a1=acceleration[p1];
+    tmatrix3d moment=TMatrix3d(0),agrad=TMatrix3d(0);
+    for(int b2=0;b2<2;b2++){
+      const bool bound=(b2==1);
+      const StNgSearch ngs=nsearch::Init(Dcellc[p1],bound,DivData);
+      for(int z=ngs.zini;z<ngs.zfin;z++)for(int y=ngs.yini;y<ngs.yfin;y++){
+        const tuint2 pif=nsearch::ParticleRange(y,z,ngs,DivData);
+        for(unsigned p2=pif.x;p2<pif.y;p2++){
+          if(!bound && !CODE_IsFluid(Codec[p2]))continue;
+          if(bound && BoundModec && BoundModec[p2]==BMODE_MDBC2OFF)continue;
+          const tdouble3 dr=TDouble3(Posc[p1].x-Posc[p2].x,(sim2d? 0: Posc[p1].y-Posc[p2].y),Posc[p1].z-Posc[p2].z);
+          const double rr2=dr.x*dr.x+dr.y*dr.y+dr.z*dr.z;
+          if(rr2>double(KernelSize2) || rr2<ALMOSTZERO || Velrhopc[p2].w<=0)continue;
+          const double fac=double(fsph::GetKernel_Fac<tker>(CSP,float(rr2)));
+          const tdouble3 grad=dr*fac;
+          const tdouble3 da=acceleration[p2]-a1;
+          const double vol=double((bound? MassBound: MassFluid)/Velrhopc[p2].w);
+          //-Build the correction from this exact stencil. The existing free-
+          // surface CorrMat can include OFF walls that this operator must skip.
+          const tdouble3 vg=grad*vol;
+          moment.a11-=dr.x*vg.x; moment.a12-=dr.x*vg.y; moment.a13-=dr.x*vg.z;
+          moment.a21-=dr.y*vg.x; moment.a22-=dr.y*vg.y; moment.a23-=dr.y*vg.z;
+          moment.a31-=dr.z*vg.x; moment.a32-=dr.z*vg.y; moment.a33-=dr.z*vg.z;
+          agrad.a11+=da.x*vg.x; agrad.a12+=da.x*vg.y; agrad.a13+=da.x*vg.z;
+          agrad.a21+=da.y*vg.x; agrad.a22+=da.y*vg.y; agrad.a23+=da.y*vg.z;
+          agrad.a31+=da.z*vg.x; agrad.a32+=da.z*vg.y; agrad.a33+=da.z*vg.z;
+        }
+      }
+    }
+    const tmatrix3d lmat=FsCorrMatInverse(moment,sim2d);
+    const double diva=agrad.a11*lmat.a11+agrad.a12*lmat.a12+agrad.a13*lmat.a13
+      +agrad.a21*lmat.a21+agrad.a22*lmat.a22+agrad.a23*lmat.a23
+      +agrad.a31*lmat.a31+agrad.a32*lmat.a32+agrad.a33*lmat.a33;
+    const double rate=double(PorePressRatec[p1])+coef*diva;
+    if(!std::isfinite(rate) || fabs(rate)>double(FLT_MAX))invalid++;
+    else PorePressRatec[p1]=float(rate);
+  }
+  if(invalid)Run_Exceptioon("PoreDynamicDarcy: non-finite or overflowing pore-pressure rate (no clipping was applied).");
+}
