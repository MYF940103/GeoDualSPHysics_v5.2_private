+//==============================================================================
+/// Runs only after all forces, soil damping and 2-D projection are complete.
+//==============================================================================
+void JSphCpu::AddPorePressureDynamicDarcyRate(){
+  //-A disabled option or zero conductivity is an exact no-op, including memory.
+  if(!HydroMech || !PoreDynamicDarcy || SoilCte.HydraulicConductivity==0)return;
+  if(!Np)return;
+  if(!Acec || !PorePressRatec || !DivData.begincell)
+    Run_Exceptioon("PoreDynamicDarcy: missing current-stage interaction arrays.");
+  if(!IsHydroMechDrainageActive()){
+    for(unsigned p=Npb;p<Np;p++)if(CODE_IsNormal(Codec[p]) && IsFreeSurfaceParticle(p,Codec,FSTypec))
+      Run_Exceptioon("PoreDynamicDarcy: undrained or not-yet-drained free surfaces require a stage-D flux boundary closure.");
+  }
+  vector<tdouble3> acceleration;
+  PreparePoreDynamicAcceleration(acceleration);
+  if(Simulate2D){
+    switch(TKernel){
+      case KERNEL_Wendland: AddPorePressureDynamicDarcyRateT<KERNEL_Wendland,true>(acceleration.data()); break;
+      case KERNEL_Cubic:    AddPorePressureDynamicDarcyRateT<KERNEL_Cubic,true>(acceleration.data()); break;
+      default: Run_Exceptioon("Kernel unknown.");
+    }
+  }
+  else{
+    switch(TKernel){
+      case KERNEL_Wendland: AddPorePressureDynamicDarcyRateT<KERNEL_Wendland,false>(acceleration.data()); break;
+      case KERNEL_Cubic:    AddPorePressureDynamicDarcyRateT<KERNEL_Cubic,false>(acceleration.data()); break;
+      default: Run_Exceptioon("Kernel unknown.");
+    }
+  }
+}
