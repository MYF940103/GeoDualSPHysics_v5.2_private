+      const tdouble3 a=ToTDouble3(Acec[p])+ToTDouble3(Gravity);
+      if(!std::isfinite(a.x) || !std::isfinite(a.y) || !std::isfinite(a.z)
+        || !std::isfinite(Velrhopc[p].w) || Velrhopc[p].w<=0)
+        Run_Exceptioon("PoreDynamicDarcy: non-finite solid acceleration or invalid particle density.");
+      acceleration[p]=TDouble3(a.x,(Simulate2D? 0: a.y),a.z);
+    }
+  }
