+      switch(TKernel){
+        case KERNEL_Wendland: PoreDynamicAccelerationBoundT<KERNEL_Wendland,true>(acceleration.data()); break;
+        case KERNEL_Cubic:    PoreDynamicAccelerationBoundT<KERNEL_Cubic,true>(acceleration.data()); break;
+        default: Run_Exceptioon("Kernel unknown.");
+      }
+    }
+    else{
+      switch(TKernel){
+        case KERNEL_Wendland: PoreDynamicAccelerationBoundT<KERNEL_Wendland,false>(acceleration.data()); break;
+        case KERNEL_Cubic:    PoreDynamicAccelerationBoundT<KERNEL_Cubic,false>(acceleration.data()); break;
+        default: Run_Exceptioon("Kernel unknown.");
+      }
+    }
+  }
