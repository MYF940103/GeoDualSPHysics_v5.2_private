+    if(TBoundary!=BC_MDBC || !MdbcCorrector || !BoundNormalc)
+      Run_Exceptioon("PoreDynamicDarcy: fixed walls require mDBC normals and MdbcCorrector=1.");
+    //-Stage B supports parallel planar walls. Curved walls require the normal
+    // material acceleration (including curvature), not this zero-normal closure.
+    tdouble3 reference=TDouble3(0);
+    bool planeset[2]={false,false};
+    double plane[2]={0,0};
+    const double planetol=max(1e-8,1e-4*Dp);
+    for(unsigned p=0;p<NpbOk;p++){
+      if(BoundModec && BoundModec[p]==BMODE_MDBC2OFF)continue;
+      const TpSlipMode slip=(BoundSlipModec? TpSlipMode(BoundSlipModec[p]): SlipMode);
+      if(slip!=SLIP_NoSlip && slip!=SLIP_FreeSlip)
+        Run_Exceptioon("PoreDynamicDarcy: fixed walls currently require NoSlip or FreeSlip.");
+      const tdouble3 normal=ToTDouble3(BoundNormalc[p]);
+      const double norm2=normal.x*normal.x+normal.y*normal.y+normal.z*normal.z;
+      if(!std::isfinite(norm2) || norm2<=ALMOSTZERO
+        || (Simulate2D && fabs(normal.y)>1e-6*sqrt(norm2)))
+        Run_Exceptioon("PoreDynamicDarcy: active wall has an invalid normal.");
+      const tdouble3 unit=normal/sqrt(norm2);
+      if(reference==TDouble3(0))reference=unit;
+      const double alignment=reference.x*unit.x+reference.y*unit.y+reference.z*unit.z;
+      if(fabs(alignment)<1.0-1e-6)
+        Run_Exceptioon("PoreDynamicDarcy: stage B supports only parallel planar fixed walls; corners/curvature require stage D.");
+      const tdouble3 wallpos=Posc[p]+normal*0.5;
+      const double offset=wallpos.x*reference.x+wallpos.y*reference.y+wallpos.z*reference.z;
+      const unsigned side=(alignment>0? 0: 1);
+      if(planeset[side] && fabs(offset-plane[side])>planetol)
+        Run_Exceptioon("PoreDynamicDarcy: same-facing wall points must lie on one plane.");
+      if(!planeset[side]){ planeset[side]=true; plane[side]=offset; }
+    }
+    if(planeset[0] && planeset[1] && plane[0]>=plane[1]-planetol)
+      Run_Exceptioon("PoreDynamicDarcy: the two fixed wall planes must face each other.");
+    const tdouble3 increments[3]={PeriXinc,PeriYinc,PeriZinc};
+    const bool periodic[3]={PeriX,PeriY,PeriZ};
+    for(unsigned axis=0;axis<3;axis++)if(periodic[axis]){
+      const tdouble3 inc=increments[axis];
+      if(fabs(inc.x*reference.x+inc.y*reference.y+inc.z*reference.z)>planetol)
+        Run_Exceptioon("PoreDynamicDarcy: periodic translations must be tangent to the fixed wall planes.");
+    }
