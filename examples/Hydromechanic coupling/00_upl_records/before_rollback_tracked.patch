+//==============================================================================
+/// Hydraulic acceleration ghosts for stationary planar impermeable walls.
+/// Reflect FULL acceleration about the wall (normal/2), not the gravity-free
+/// Acec value. This makes a_s.normal=0 at the wall, so the existing homogeneous
+/// excess-pressure Neumann condition remains valid. It is not a modification
+/// of the mechanical mDBC velocity ghosts.
+//==============================================================================
+template<TpKernel tker,bool sim2d> void JSphCpu::PoreDynamicAccelerationBoundT(tdouble3 *acceleration)const{
+  //-Like mDBC, process only wall particles that can interact with fluid. Images
+  // use a wrapped ghost position and the already synchronized fluid field; a
+  // wall image's normal owner can be outside NpbOk or have a different OFF flag.
+  for(unsigned p1=0;p1<NpbOk;p1++){
+    if(BoundModec && BoundModec[p1]==BMODE_MDBC2OFF)continue;
+    const tdouble3 normal=ToTDouble3(BoundNormalc[p1]);
+    tdouble3 gpos=Posc[p1]+normal;
+    if(PeriActive)gpos=UpdatePeriodicPos(gpos);
+    tmatrix3d mat2=TMatrix3d(0);
+    tmatrix4d mat3=TMatrix4d(0);
+    double sumw=0;
+    tdouble3 suma=TDouble3(0),sumax=TDouble3(0),sumay=TDouble3(0),sumaz=TDouble3(0);
+    const StNgSearch ngs=nsearch::Init(gpos,false,DivData);
+    for(int z=ngs.zini;z<ngs.zfin;z++)for(int y=ngs.yini;y<ngs.yfin;y++){
+      const tuint2 pif=nsearch::ParticleRange(y,z,ngs,DivData);
+      for(unsigned p2=pif.x;p2<pif.y;p2++)if(CODE_IsFluid(Codec[p2]) && Velrhopc[p2].w>0){
+        const tdouble3 dr=TDouble3(gpos.x-Posc[p2].x,(sim2d? 0: gpos.y-Posc[p2].y),gpos.z-Posc[p2].z);
+        const float rr2=float(dr.x*dr.x+dr.y*dr.y+dr.z*dr.z);
+        if(rr2>KernelSize2)continue;
+        float fac=0;
+        const double wab=double(rr2>0? fsph::GetKernel_WabFac<tker>(CSP,rr2,fac): fsph::GetKernel_Wab<tker>(CSP,0));
+        const double vol=double(MassFluid/Velrhopc[p2].w);
+        const double w=vol*wab,fx=vol*fac*dr.x,fy=vol*fac*dr.y,fz=vol*fac*dr.z;
+        const tdouble3 a=acceleration[p2];
+        sumw+=w; suma=suma+a*w;
+        sumax=sumax+a*fx; sumay=sumay+a*fy; sumaz=sumaz+a*fz;
+        if(sim2d){
+          mat2.a11+=w;  mat2.a12+=dr.x*w;  mat2.a13+=dr.z*w;
+          mat2.a21+=fx; mat2.a22+=dr.x*fx; mat2.a23+=dr.z*fx;
+          mat2.a31+=fz; mat2.a32+=dr.x*fz; mat2.a33+=dr.z*fz;
+        }
+        else{
+          mat3.a11+=w;  mat3.a12+=dr.x*w;  mat3.a13+=dr.y*w;  mat3.a14+=dr.z*w;
+          mat3.a21+=fx; mat3.a22+=dr.x*fx; mat3.a23+=dr.y*fx; mat3.a24+=dr.z*fx;
+          mat3.a31+=fy; mat3.a32+=dr.x*fy; mat3.a33+=dr.y*fy; mat3.a34+=dr.z*fy;
+          mat3.a41+=fz; mat3.a42+=dr.x*fz; mat3.a43+=dr.y*fz; mat3.a44+=dr.z*fz;
+        }
+      }
+    }
+    if(!std::isfinite(sumw) || sumw<=0)
+      Run_Exceptioon("PoreDynamicDarcy: active wall acceleration ghost has no fluid support.");
+    tdouble3 ag=suma/sumw; //-Same zero-order/MLS-intercept selection as pore pressure.
+    if(PoreMdbcInterpolationMode==1){
+      if(sim2d){
+        const double det=fmath::Determinant3x3(mat2);
+        if(fabs(det)>=1e-3){
+          const tmatrix3d inv=fmath::InverseMatrix3x3(mat2,det);
+          ag=suma*inv.a11+sumax*inv.a12+sumaz*inv.a13;
+        }
+      }
+      else{
+        const double det=fmath::Determinant4x4(mat3);
+        if(fabs(det)>=1e-3){
+          const tmatrix4d inv=fmath::InverseMatrix4x4(mat3,det);
+          ag=suma*inv.a11+sumax*inv.a12+sumay*inv.a13+sumaz*inv.a14;
+        }
+      }
+    }
+    const TpSlipMode slip=(BoundSlipModec? TpSlipMode(BoundSlipModec[p1]): SlipMode);
+    if(slip==SLIP_NoSlip)ag=ag*(-1.0);
+    else{
+      const double dot=ag.x*normal.x+ag.y*normal.y+ag.z*normal.z;
+      const double norm2=normal.x*normal.x+normal.y*normal.y+normal.z*normal.z;
+      ag=ag-normal*(2.0*dot/norm2);
+    }
+    if(!std::isfinite(ag.x) || !std::isfinite(ag.y) || !std::isfinite(ag.z))
+      Run_Exceptioon("PoreDynamicDarcy: non-finite wall acceleration ghost.");
+    acceleration[p1]=ag;
+  }
+}
