static const char* Cases[2]={"original","radial"};
static bool Selected(unsigned part){return part>=29&&part<=31;}
static std::vector<std::string> Split(const std::string&s){std::vector<std::string>c;std::stringstream f(s);std::string x;while(std::getline(f,x,','))c.push_back(x);return c;}
struct Control{bool gradient=false,soil=false;double time=0,theta=0,C[9]={},passTheta[2]={};unsigned step=0,fs=0;float acex=0,acez=0,rate=0,rs[6]={},grad[2][2][9]={};};
static unsigned ControlSlot(unsigned cs,unsigned part,unsigned id){Need(cs<2&&Selected(part)&&id>=2060&&id<Original,"Closed control index differs");return (cs*3+part-29)*Original+id;}
static std::vector<Control> ReadControls(const pf::path& root){
 std::vector<Control> out(6*Original);unsigned counts[2]={};
 for(unsigned kind=0;kind<2;kind++){std::ifstream f(root/(kind?"soil.csv":"gradient.csv"));std::string line;Need(bool(std::getline(f,line)),"Missing sealed CPU control CSV");const auto h=Split(line);Need(h.size()==(kind?54:87),"Sealed control schema differs");auto Col=[&](const std::string&name){auto p=std::find(h.begin(),h.end(),name);Need(p!=h.end(),"Control column missing: "+name);return unsigned(p-h.begin());};unsigned all=0;
  while(std::getline(f,line)){auto c=Split(line);Need(c.size()==h.size(),"Sealed CPU control row width differs");all++;const unsigned part=std::stoul(c[Col("part")]);if(!Selected(part))continue;const auto label=c[Col("case")];Need(label=="original"||label=="radial","Unknown sealed CPU case");const unsigned cs=label=="radial",id=std::stoul(c[Col("native_id")]);auto&r=out[ControlSlot(cs,part,id)];const double time=std::stod(c[Col("time_s")]);const unsigned step=std::stoul(c[Col("completed_step")]);if(r.gradient||r.soil)Need(Bits(r.time,time)&&r.step==step,"Control clock joins differ");r.time=time;r.step=step;
   if(kind){Need(!r.soil,"Duplicate soil control");r.soil=true;r.acex=float(std::stod(c[Col("base_Acex")]));r.acez=float(std::stod(c[Col("base_Acez")]));r.rate=float(std::stod(c[Col("base_R_Pa_s")]));}
   else{Need(!r.gradient,"Duplicate gradient control");r.gradient=true;r.theta=std::stod(c[Col("fresh_CPU_theta_s_1")]);r.fs=std::stoul(c[Col("fresh_FS")]);const char*sn[6]={"xx","yy","zz","xy","yz","xz"};for(unsigned k=0;k<6;k++)r.rs[k]=float(std::stod(c[Col(std::string("Rsigma_")+sn[k]+"_Pa_s")]));for(unsigned a=0;a<3;a++)for(unsigned b=0;b<3;b++)r.C[3*a+b]=std::stod(c[Col("C"+std::to_string(a+1)+std::to_string(b+1))]);const char*gn[9]={"xx","xy","xz","yx","yy","yz","zx","zy","zz"};for(unsigned p=0;p<2;p++){const std::string group=p?"bound":"fluid";r.passTheta[p]=std::stod(c[Col(group+"_theta_s_1")]);for(unsigned k=0;k<2;k++)for(unsigned j=0;j<9;j++)r.grad[p][k][j]=float(std::stod(c[Col(group+(k?"_corrected_grad_":"_raw_grad_")+gn[j]+"_s_1")]));}}
   counts[kind]++;
  }Need(all==70000,"Complete original fourteen-state CSV required");
 }Need(counts[0]==30000&&counts[1]==30000,"Exactly six-state CPU controls required");for(unsigned cs=0;cs<2;cs++)for(unsigned part=29;part<=31;part++)for(unsigned id=2060;id<Original;id++){const auto&r=out[ControlSlot(cs,part,id)];Need(r.gradient&&r.soil,"Missing selected material control");}return out;
}
