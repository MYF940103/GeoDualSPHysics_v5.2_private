    <mkconfig boundcount="8" fluidcount="4" />
    <geometry>
      <predefinition>
        <newvarcte SphereRadius="0.05" _rem="Draft radius a; confirm from paper or user before running" />
        <newvarcte Dp="0.005" _rem="Draft coarse spacing a/10" />
        <newvarcte DomainHalf="0.08" _rem="Draft domain padding" />
      </predefinition>
      <definition dp="#Dp" units_comment="metres (m)">
        <pointref x="0" y="0" z="0" />
        <pointmin x="#-DomainHalf" y="#-DomainHalf" z="#-DomainHalf" />
        <pointmax x="#DomainHalf" y="#DomainHalf" z="#DomainHalf" />
      </definition>
      <commands>
        <mainlist>
          <setdrawmode mode="full" />
          <setmkfluid mk="0" name="PoroelasticSphere_DRAFT" />
