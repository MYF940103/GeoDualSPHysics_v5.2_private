<?xml version="1.0" encoding="UTF-8" ?>
<!-- Parameter examples. Defaults refer to omitted XML keys, not the example values below. -->
<case>
	<execution>
		<special>
			<soils>
				<!-- Elasticity and strength; angles are in degrees. K and G are derived from E and nu. -->
				<ModulusE value="1.0e6" comment="Young modulus; parser default=0; specify a positive material value" units_comment="Pa" />
				<PRvs value="0.3" comment="Poisson ratio; default=0" />
				<phi value="30" comment="Peak friction angle; default=0" units_comment="degrees" />
				<coh value="0" comment="Peak cohesion; default=0" units_comment="Pa" />
				<dlt value="0" comment="Initial dilation angle; default=0" units_comment="degrees" />

				<!-- Return algorithm is independent of strength softening and hydromechanics. -->
				<MaterialReturn value="0" comment="0=LegacyFast, 1=experimental ConsistentDev; default=0" />
				<!-- Mode1: fresh 2D DP_PS (DPCtes=3), Symplectic, fixed phi in (0,90) and n_phi=0; no apex return or PART restart. -->

				<!-- Softening: residual strength must be supplied when its decay coefficient is positive. -->
				<phi_r value="30" comment="Residual friction angle; default=phi" units_comment="degrees" />
				<coh_r value="0" comment="Residual cohesion; default=coh" units_comment="Pa" />
				<n_phi value="0" comment="Friction-angle exponential decay coefficient; default=0" />
				<n_coh value="0" comment="Cohesion exponential decay coefficient; default=0" />
				<DilationDecay value="0" comment="sf in psi=psi0*exp(-sf*kappa); default=0; sf>=0; nonzero requires MaterialReturn=1" />
				<SoilTriggerFos value="1.65" comment="Restart strength-reduction factor for strength softening; default=1.65; must be >=1" />
			</soils>

			<hydromechanics>
				<!-- Move the whole hydromechanical configuration here when migrating it from legacy soils XML. -->
				<HydroMech value="1" comment="Enable hydromechanical coupling; default=0" />
				<HydroMechDynamicSeepage value="0" comment="0=original u-pw, 1=experimental dynamic seepage with evolving J/n; default=0" />
				<!-- Dynamic seepage has restricted feature combinations; see the case README. PART restart is unsupported. -->
				<HydroMechConductivityModel value="0" comment="Dynamic seepage: 0=constant k0, 1=void-ratio exponential k(J); default=0" />
				<!-- Model1 requires dynamic seepage and explicit Ck>0: k=k0*exp((e-e0)/Ck), e-e0=(J-1)/(1-n0). -->
				<!-- <HydroMechConductivityCk value="0.01" comment="Example only; natural-log conductivity index; default=0, no calibrated universal value" /> -->

				<PoreWaterRho value="1000" comment="Reference water density; default=1000" units_comment="kg/m^3" />
				<PoreWaterBulkModulus value="2.0e6" comment="Water bulk modulus; default=0; must be >0 when HydroMech=1" units_comment="Pa" />
				<Porosity value="0.3" comment="Reference porosity n0; default=0; must be in (0,1) when HydroMech=1" />
				<HydraulicConductivity value="1.0e-4" comment="Initial hydraulic conductivity k0; default=0; must be >=0" units_comment="m/s" />

				<PoreDtSafety value="0.1" comment="Pore-diffusion step safety factor; default=0.1; must be >0" />
				<!-- Legacy DtFixed bypasses automatic pore-step limiting; dynamic seepage checks its necessary coupled limits. -->
				<PoreShepardRegularization value="0" comment="Excess-pressure Shepard regularization 0=off, 1=on; default=0" />
				<PoreShepardInterval value="30" comment="Regularization interval in steps; default=30; positive when enabled" />
				<!-- Experimental dynamic Shepard: constant-k fixed gravity preload with mode2 hydrostatic baseline; J-volume weights. -->
				<PoreMdbcInterpolationMode value="0" comment="Legacy pore-boundary interpolation 0=zero order, 1=direct MLS; default=0" />
				<PoreDarcySymmetricCorr value="0" comment="Legacy Darcy correction 0=receiver C, 1=mean pair C for soil pairs; default=0" />

				<HydroMechInitMode value="0" comment="0=None, 1=FreeSurface, 2=ConstantZ, 3=AnalyticalSelfWeight1D; default=0" />
				<!-- <HydroMechInitZ value="1.0" comment="Required in mode2; parser default=0; otherwise unused" units_comment="m" /> -->
				<!-- Dynamic mode2 is restricted to the fully saturated flat-top gravity container; initializes pore pressure only, with zero initial effective stress. -->

				<HydroMechTopLoadMode value="0" comment="0=None, 1=TopVertical, 2=FlexibleConfinement, 3=TopStripVertical, 4=LianFlexibleStrip, 5=TopKernelBand; default=0" />
				<!-- Modes3/4 use case-specific strip geometry; mode5 spreads the top load over a horizontal kernel band. -->
				<HydroMechTopLoadQ0 value="0" comment="Compressive load; default=0; must be >0 when loading is enabled" units_comment="Pa" />
				<HydroMechTopLoadRampTime value="0" comment="Load ramp duration; default=0; must be >=0" units_comment="s" />

				<HydroMechDrainage value="1" comment="Zero pore pressure at tracked drained free-surface soil; default=1" />
				<HydroMechDrainageStartTime value="0" comment="Drainage opening time; default=0; must be >=0" units_comment="s" />
				<HydroMechDrainageFixedGrid value="0" comment="Align drainage event to the fixed-step count; default=0; requires a fresh constant-DtFixed run" />
				<!-- With fixed-grid drainage, opening time must be an integer multiple of DtFixed. -->
				<HydroMechFreeSeepage value="0" comment="Experimental dynamic free-seepage surface; default=0; requires HydroMechDrainage=0 and HydroMechDrainageFixedGrid=0" />
				<!-- FreeSeepage projects positive surface pressure to zero at completed steps; negative pressure is retained. -->
			</hydromechanics>

			<!-- Optional mechanical wall-slip overrides; requires Boundary=2 and existing, unique mkbound values. -->
			<mdbcslip>
				<bound mkbound="0" slipmode="3" comment="Example: side walls FreeSlip; unlisted boundaries inherit global SlipMode" />
				<bound mkbound="1" slipmode="2" comment="Example: bed NoSlip" />
			</mdbcslip>
		</special>

		<parameters>
			<parameter key="DPCtes" value="1" comment="1=3D circumscribed, 2=Mohr-Coulomb mapping, 3=plane strain; default=1" />

			<!-- Soil stabilization. -->
			<parameter key="ArtificialStress" value="0" comment="Artificial stress 0=off, 1=on; default=0" />
			<parameter key="ArtificialStressCoef" value="0.2" comment="Artificial-stress coefficient; default=0.2; range [0,1]" />
			<parameter key="SoilStressRateGradCorr" value="0" comment="Stress-rate velocity-gradient correction 0=off, 1=on; default=0" />
			<parameter key="SoilBoundaryDerivativeSPR" value="0" comment="Reconstructed wall velocity for soil derivatives 0=off, 1=on; default=0" />
			<!-- SPR supports fixed planar walls; per-mk modes require separate faces. Inclined NoPen and curved/moving walls are unsupported. -->
			<parameter key="SoilHourglassXi" value="0" comment="Elastic GNOG hourglass strength; default=0 (off); must be >=0" />
			<!-- HG: 2D Wendland/Symplectic, small-rotation elastic soil; no plasticity or history restart. -->
			<parameter key="SoilDamping" value="0" comment="Bui-Fukagawa soil damping 0=off, 1=on; default=0" />
			<parameter key="SoilDampingCoef" value="0.02" comment="Damping coefficient; default=0.02; >=0 (dynamic: at most0.1)" />
			<parameter key="DensityDT" value="0" comment="Soil stress diffusion 0=off, 1=Molteni, 2=Feng/Fourtakas, 3=internal-fluid only; default=0" />
			<parameter key="DensityDTvalue" value="0.1" comment="Stress-diffusion coefficient; default=0.1" />

			<!-- Mechanical mDBC settings are separate from pore-pressure boundary conditions. -->
			<parameter key="Boundary" value="2" comment="1=DBC, 2=mDBC; default=1" />
			<parameter key="SlipMode" value="1" comment="mDBC wall velocity 1=Vel0, 2=NoSlip, 3=FreeSlip; default=1" />
			<parameter key="MDBCCorrector" value="1" comment="mDBC in Symplectic corrector 0=off, 1=on; default=1" />
			<parameter key="MDBCFastSingle" value="1" comment="Fast single-precision mDBC; default=1; CPU and hydromechanics force the double path" />
			<!-- <parameter key="NoPenetration" value="1" comment="mDBC NoSlip/FreeSlip penetration correction; default=0" /> -->

			<!-- Existing DualSPHysics viscosity and shifting controls. -->
			<parameter key="ViscoTreatment" value="1" comment="1=artificial viscosity, 2=laminar+SPS; default=1" />
			<parameter key="Visco" value="0.01" comment="Viscosity coefficient; required, no XML default" />
			<parameter key="Shifting" value="0" comment="0=off, 1=ignore boundaries, 2=ignore fixed, 3=full; default=0" />
			<parameter key="ShiftCoef" value="-2" comment="Shifting coefficient when enabled; default=-2" />
			<parameter key="ShiftTFS" value="0" comment="Shifting free-surface threshold; default=0; typical 2D/3D values 1.5/2.75" />
		</parameters>
	</execution>
</case>
